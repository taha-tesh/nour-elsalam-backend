# Server
PORT=3000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/bayt_al_adad?schema=public"

# JWT (use a long random string in production)
JWT_SECRET="change-me-to-a-secure-random-string-in-production"
JWT_EXPIRES_IN="7d"

# Default admin account (created by seed if not exists)
ADMIN_NAME="مدير النظام"
ADMIN_EMAIL="admin@baytaladad.com"
ADMIN_PASSWORD="Admin@123456"
ADMIN_PHONE="+966500000000"
